{
  "manifest_version": 3,
  "name": "Sonar Catch",
  "version": "0.1.0",
  "description": "Detects the job posting open in Indeed's detail pane and sends it to Sonar's ingestion API.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sonar Catch settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/adapters/chrome/options/options.html",
  "background": {
    "service_worker": "src/adapters/chrome/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.indeed.com/*", "https://*.indeed.com/*"],
      "js": ["src/adapters/chrome/content-script.ts"],
      "css": ["src/adapters/chrome/ui.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://www.indeed.com/*", "https://*.indeed.com/*"],
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
