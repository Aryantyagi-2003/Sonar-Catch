{
  "manifest_version": 3,
  "name": "Sonar Catch",
  "version": "0.1.5",
  "description": "Detects the job posting open on Indeed, LinkedIn, and select company career sites (RBC, Walmart, Best Buy Canada, CIBC) and sends it to Sonar's ingestion API.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sonar Catch settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/adapters/webextension/options/options.html",
  "background": {
    "service_worker": "src/adapters/webextension/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.indeed.com/*",
        "https://*.indeed.com/*",
        "https://jobs.rbc.com/*",
        "https://careers.walmart.com/*",
        "https://bestbuycanada.wd3.myworkdayjobs.com/*",
        "https://cibc.wd3.myworkdayjobs.com/*",
        "https://www.linkedin.com/jobs/*"
      ],
      "js": ["src/adapters/webextension/content-script.ts"],
      "css": ["src/adapters/webextension/ui.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.indeed.com/*",
    "https://*.indeed.com/*",
    "https://jobs.rbc.com/*",
    "https://careers.walmart.com/*",
    "https://bestbuycanada.wd3.myworkdayjobs.com/*",
    "https://cibc.wd3.myworkdayjobs.com/*",
    "https://www.linkedin.com/jobs/*"
  ],
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
