{
  "name": "sonar-catch",
  "version": "0.1.8",
  "private": true,
  "description": "Browser extension companion to Sonar: detects the job posting open in Indeed's detail pane and sends it to Sonar's ingestion API.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "build:chrome": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && node scripts/build-firefox.mjs",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "@types/webextension-polyfill": "^0.12.5",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
